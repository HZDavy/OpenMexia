{
  "name": "mijia-widget",
  "productName": "OpenMexia",
  "version": "0.1.3",
  "private": true,
  "description": "OpenMexia：开源、全平台、多协议的智能家居控制中枢。目标是支持所有智能协议，凡能以开源方式支持的协议都尽力纳入；目前已支持米家（Windows 已发布，macOS / iOS / Android 规划中）",
  "author": "HZDavy",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/HZDavy/OpenMexia.git"
  },
  "main": "build/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "build:renderer": "esbuild renderer/app.ts --bundle --format=iife --target=es2022 --outfile=build/renderer/app.js",
    "build": "tsc && npm run build:renderer && node scripts/copy-static.js",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.hzdavy.mijia-widget",
    "productName": "OpenMexia",
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 HZDavy",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenMexia",
      "uninstallDisplayName": "OpenMexia"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@zythum02/mijia-api": "^0.1.5",
    "node-mihome": "^0.0.32",
    "qrcode": "^1.5.4"
  }
}
